<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Dpz.Core.WebMore.App"
             xmlns:webmore="clr-namespace:Dpz.Core.WebMore;assembly=Dpz.Core.WebMore"
             x:Class="Dpz.Core.WebMore.App.MainPage">

    <Grid>
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type webmore:WebMoreApp}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <!-- Background Lyrics (above WebView) -->
        <VerticalStackLayout x:Name="mainBgLyricsContainer" 
                            IsVisible="False" 
                            VerticalOptions="End" 
                            HorizontalOptions="Center" 
                            Margin="0,0,0,140" 
                            Spacing="12"
                            MaximumWidthRequest="800"
                            InputTransparent="True">
            <Label x:Name="mainBgCurrentLyric" 
                   Text="" 
                   TextColor="#FFB700"
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Opacity="1.0"
                   Padding="20,0" />
            <Label x:Name="mainBgNextLyric" 
                   Text="" 
                   TextColor="Gray"
                   FontSize="20" 
                   HorizontalTextAlignment="Center"
                   Opacity="0.6"
                   Padding="20,0" />
        </VerticalStackLayout>

        <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="End" Spacing="12" Margin="16">
            <Button
                x:Name="logViewerButton"
                Text="🧾"
                FontSize="18"
                WidthRequest="48"
                HeightRequest="48"
                CornerRadius="24"
                Padding="0"
                BackgroundColor="#1A1A1A"
                TextColor="#F2F2F2"
                Clicked="OnOpenLogViewer" />

            <!-- Mini Music Player -->
            <Grid x:Name="miniMusicPlayer" 
                  WidthRequest="70" 
                  HeightRequest="70"
                  IsVisible="{OnPlatform Android=true, WinUI=true, Default=false}">
                <!-- Outer Ring -->
                <GraphicsView x:Name="mainMiniOuterRingView"
                              WidthRequest="70"
                              HeightRequest="70"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                <!-- Progress Ring -->
                <GraphicsView x:Name="mainMiniProgressRingView"
                              WidthRequest="70"
                              HeightRequest="70"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                <!-- Cover -->
                <Border WidthRequest="50" 
                        HeightRequest="50" 
                        StrokeShape="RoundRectangle 25" 
                        StrokeThickness="2" 
                        Stroke="#2A2A2A" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center">
                    <Image x:Name="mainMiniCoverImage" Aspect="AspectFill" />
                </Border>
                <!-- Overlay -->
                <Grid x:Name="mainMiniOverlay" 
                      WidthRequest="70" 
                      HeightRequest="70" 
                      Opacity="0">
                    <Border StrokeShape="RoundRectangle 35" 
                            BackgroundColor="#66000000" />
                    <Label x:Name="mainMiniPlayIcon" 
                           Text="{x:Static local:FontAwesomeIcons.Play}" 
                           FontFamily="FASolid"
                           TextColor="White" 
                           FontSize="20" 
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center" />
                </Grid>
                <!-- Touch Button -->
                <Button BackgroundColor="Transparent" 
                        Opacity="0.01" 
                        WidthRequest="70" 
                        HeightRequest="70"
                        Clicked="OnMiniPlayerClick"
                        Pressed="OnMiniPlayerPressed" 
                        Released="OnMiniPlayerReleased" />
            </Grid>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
