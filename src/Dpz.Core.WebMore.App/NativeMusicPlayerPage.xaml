<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="using:Dpz.Core.WebMore.App"
             x:Class="Dpz.Core.WebMore.App.NativeMusicPlayerPage"
             BackgroundColor="#141210">

    <ContentPage.Resources>
        <Color x:Key="ThemeColor">#FFB700</Color>
        <Color x:Key="SecondaryColor">#00F3FF</Color>
        <Color x:Key="TextPrimary">#E6E2DD</Color>
        <Color x:Key="TextSecondary">#A69E96</Color>
        <Color x:Key="PanelBg">#141210</Color>
        <Color x:Key="PanelBgLight">#1E1E1E</Color>
        <Color x:Key="BorderColor">#3A3A3A</Color>
        
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        
        <Style TargetType="Button" x:Key="MainButton">
            <Setter Property="WidthRequest" Value="64" />
            <Setter Property="HeightRequest" Value="64" />
            <Setter Property="BackgroundColor" Value="{StaticResource ThemeColor}" />
            <Setter Property="TextColor" Value="#000000" />
            <Setter Property="FontSize" Value="24" />
        </Style>
        
        <Style TargetType="Button" x:Key="TextButton">
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Lyrics Container -->
        <Grid x:Name="bgLyricsContainer" IsVisible="False" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,20" 
              Padding="20,0" MaximumWidthRequest="800" HeightRequest="100">
            <CollectionView x:Name="bgLyricsView" InputTransparent="True" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Text}" 
                               TextColor="{Binding Color}" 
                               FontSize="{Binding FontSize}" 
                               Opacity="{Binding Opacity}"
                               HorizontalTextAlignment="Center" 
                               FontAttributes="{Binding FontWeight}"
                               Padding="8,0" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Full Panel -->
        <Grid x:Name="fullPanel" IsVisible="True" BackgroundColor="{StaticResource PanelBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Padding="20" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource PanelBgLight}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="titleLabel" 
                           Text="Loading..." 
                           FontSize="20" 
                           TextColor="{StaticResource ThemeColor}" 
                           FontAttributes="Bold" 
                           LineBreakMode="TailTruncation" 
                           TextTransform="Uppercase" />
                    <Label x:Name="artistLabel" 
                           Text="-" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                
                <HorizontalStackLayout Grid.Column="1" Spacing="0">
                    <Button Text="{x:Static local:FontAwesomeIcons.AngleDown}" 
                            FontFamily="FASolid"
                            Style="{StaticResource TextButton}"
                            Clicked="OnToggleMini" 
                            ToolTipProperties.Text="最小化" />
                    <Button Text="{x:Static local:FontAwesomeIcons.Times}" 
                            FontFamily="FASolid"
                            Style="{StaticResource TextButton}"
                            Clicked="OnClose" 
                            ToolTipProperties.Text="关闭" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Main Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20" Spacing="20">
                    <!-- Cover / Lyrics Area -->
                    <Grid WidthRequest="300" HeightRequest="300" HorizontalOptions="Center">
                        <!-- Reactor with Rings -->
                        <Grid x:Name="reactorContainer" IsVisible="True">
                            <!-- Ring Drawables -->
                            <GraphicsView x:Name="ring1View" />
                            <GraphicsView x:Name="ring2View" />
                            <GraphicsView x:Name="ring3View" />
                            
                            <!-- Center Cover -->
                            <Border WidthRequest="160" 
                                    HeightRequest="160" 
                                    StrokeShape="RoundRectangle 80" 
                                    StrokeThickness="2" 
                                    Stroke="{StaticResource ThemeColor}" 
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                                <Image x:Name="coverImage" Aspect="AspectFill" />
                            </Border>
                        </Grid>

                        <!-- Lyrics Display -->
                        <CollectionView x:Name="lyricsView" IsVisible="False">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding Text}" 
                                           TextColor="{Binding Color}" 
                                           FontSize="{Binding FontSize}" 
                                           HorizontalTextAlignment="Center" 
                                           FontAttributes="{Binding FontWeight}"
                                           Padding="8,6" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- Progress Bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="10,0" VerticalOptions="Center">
                        <Label x:Name="currentTimeLabel" 
                               Text="0:00" 
                               FontSize="12" 
                               TextColor="{StaticResource TextSecondary}" 
                               WidthRequest="45" 
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                        <Slider x:Name="seekSlider" 
                                Grid.Column="1" 
                                Minimum="0" 
                                Maximum="100" 
                                ValueChanged="OnSeekChanged" 
                                DragStarted="OnSeekDragStarted" 
                                DragCompleted="OnSeekDragCompleted" 
                                MinimumTrackColor="{StaticResource ThemeColor}" 
                                MaximumTrackColor="#2A2A2A" 
                                ThumbColor="{StaticResource ThemeColor}"
                                VerticalOptions="Center" />
                        <Label x:Name="durationLabel" 
                               Grid.Column="2" 
                               Text="0:00" 
                               FontSize="12" 
                               TextColor="{StaticResource TextSecondary}" 
                               WidthRequest="45" 
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <!-- Play Controls -->
                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                        <Button Text="{x:Static local:FontAwesomeIcons.StepBackward}" 
                                FontFamily="FASolid"
                                Style="{StaticResource IconButton}" 
                                Clicked="OnPrev" 
                                ToolTipProperties.Text="上一首" />
                        <Button x:Name="playButton" 
                                Text="{x:Static local:FontAwesomeIcons.Play}" 
                                FontFamily="FASolid"
                                Style="{StaticResource MainButton}" 
                                Clicked="OnPlayPause" 
                                ToolTipProperties.Text="播放/暂停" />
                        <Button Text="{x:Static local:FontAwesomeIcons.StepForward}" 
                                FontFamily="FASolid"
                                Style="{StaticResource IconButton}" 
                                Clicked="OnNext" 
                                ToolTipProperties.Text="下一首" />
                    </HorizontalStackLayout>

                    <!-- Extra Controls -->
                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Button x:Name="modeButton" 
                                Text="{x:Static local:FontAwesomeIcons.SortAmountAsc}" 
                                FontFamily="FASolid"
                                Style="{StaticResource TextButton}" 
                                Clicked="OnCycleMode" />
                        <Button x:Name="lyricButton" 
                                Text="{x:Static local:FontAwesomeIcons.FileLines}" 
                                FontFamily="FARegular"
                                Style="{StaticResource TextButton}" 
                                Clicked="OnToggleLyrics" 
                                ToolTipProperties.Text="歌词" />
                        <Button x:Name="listButton" 
                                Text="{x:Static local:FontAwesomeIcons.ListUl}" 
                                FontFamily="FASolid"
                                Style="{StaticResource TextButton}" 
                                Clicked="OnToggleList" 
                                ToolTipProperties.Text="播放列表" />
                    </HorizontalStackLayout>

                    <!-- Playlist -->
                    <Border x:Name="listPanel" 
                            IsVisible="False" 
                            Stroke="{StaticResource BorderColor}" 
                            StrokeThickness="2" 
                            Padding="0" 
                            MinimumHeightRequest="300" 
                            MaximumHeightRequest="400">
                        <CollectionView x:Name="trackList" 
                                        SelectionMode="Single" 
                                        SelectionChanged="OnTrackSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnDefinitions="Auto,*">
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#33FFB700" />
                                            </DataTrigger>
                                        </Grid.Triggers>
                                        <Label Text="{Binding Index}" 
                                               TextColor="{StaticResource TextSecondary}" 
                                               WidthRequest="32" 
                                               FontSize="12" 
                                               HorizontalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" 
                                                   TextColor="{StaticResource TextPrimary}" 
                                                   FontSize="14" 
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Artist}" 
                                                   TextColor="{StaticResource TextSecondary}" 
                                                   FontSize="12" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Mini Player -->
        <Grid x:Name="miniPanel" 
              IsVisible="False" 
              WidthRequest="70" 
              HeightRequest="70" 
              VerticalOptions="Start" 
              HorizontalOptions="Start" 
              Margin="20">
            <!-- Outer Ring -->
            <GraphicsView x:Name="miniOuterRingView" />
            <!-- Progress Ring -->
            <GraphicsView x:Name="miniProgressRingView" />
            <!-- Cover -->
            <Border WidthRequest="50" 
                    HeightRequest="50" 
                    StrokeShape="RoundRectangle 25" 
                    StrokeThickness="2" 
                    Stroke="#2A2A2A" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center">
                <Image x:Name="miniCoverImage" Aspect="AspectFill" />
            </Border>
            <!-- Overlay -->
            <Grid x:Name="miniOverlay" 
                  WidthRequest="70" 
                  HeightRequest="70" 
                  Opacity="0">
                <Border StrokeShape="RoundRectangle 35" 
                        BackgroundColor="#66000000" />
                <Label x:Name="miniPlayIcon" 
                       Text="{x:Static local:FontAwesomeIcons.Play}" 
                       FontFamily="FASolid"
                       TextColor="White" 
                       FontSize="20" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center" />
            </Grid>
            <!-- Touch Button -->
            <Button BackgroundColor="Transparent" 
                    Opacity="0.01" 
                    WidthRequest="70" 
                    HeightRequest="70"
                    Pressed="OnMiniPressed" 
                    Released="OnMiniReleased" />
        </Grid>
    </Grid>
</ContentPage>
